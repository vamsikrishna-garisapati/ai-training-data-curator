{
  "title": "AI Training Data Curator Output",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "url": {
      "title": "URL",
      "type": "string",
      "description": "Canonical page URL"
    },
    "title": {
      "title": "Title",
      "type": "string",
      "description": "Page title"
    },
    "text": {
      "title": "Text",
      "type": "string",
      "description": "Extracted body text"
    },
    "author": {
      "title": "Author",
      "type": "string",
      "description": "Author if detected"
    },
    "publishedDate": {
      "title": "Published Date",
      "type": "string",
      "description": "Publication date if detected"
    },
    "language": {
      "title": "Language",
      "type": "string",
      "description": "Detected ISO 639-1 language code"
    },
    "wordCount": {
      "title": "Word Count",
      "type": "integer",
      "description": "Number of words in extracted text"
    }
  },
  "views": {
    "overview": {
      "title": "Overview",
      "transformation": {
        "fields": ["url", "title", "wordCount", "language", "author", "publishedDate"]
      },
      "display": {
        "component": "table",
        "properties": {
          "url": { "label": "URL", "format": "link" },
          "title": { "label": "Title" },
          "wordCount": { "label": "Words", "format": "number" },
          "language": { "label": "Language" },
          "author": { "label": "Author" },
          "publishedDate": { "label": "Published" }
        }
      }
    }
  }
}
