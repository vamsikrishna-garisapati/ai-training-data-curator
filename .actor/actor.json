{
  "$schema": "https://apify-projects.github.io/actor-json-schemas/actor.json?v=0.7",
  "actorSpecification": 1,
  "name": "ai-training-data-curator",
  "title": "AI Training Data Curator",
  "description": "Turn any public website into a clean LLM training dataset. Crawl docs, blogs, and help centers; extract readable text; filter by language and quality; remove duplicates; export JSON, JSONL, or CSV for fine-tuning, RAG, and AI workflows.",
  "seoTitle": "Website to LLM Dataset | AI Training Data Tool",
  "seoDescription": "Crawl public websites and export clean LLM training data for fine-tuning and RAG. Auto-extract text, remove duplicates, download JSON or CSV. No code needed.",
  "version": "0.1",
  "buildTag": "latest",
  "dockerfile": "../Dockerfile",
  "readme": "./README.md",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "categories": ["AI", "DEVELOPER_TOOLS"],
  "defaultRunOptions": {
    "memoryMbytes": 1024,
    "timeoutSecs": 3600
  },
  "meta": {
    "origin": "AI Training Data Curator"
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "fields": {},
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": ["url", "title", "text", "wordCount", "language", "author", "publishedDate"]
          },
          "display": {
            "component": "table",
            "properties": {
              "url": { "label": "URL", "format": "link" },
              "title": { "label": "Title", "format": "text" },
              "text": { "label": "Text", "format": "text" },
              "wordCount": { "label": "Words", "format": "number" },
              "language": { "label": "Language" },
              "author": { "label": "Author" },
              "publishedDate": { "label": "Published" }
            }
          }
        }
      }
    }
  }
}
