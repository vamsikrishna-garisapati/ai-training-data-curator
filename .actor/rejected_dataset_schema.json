{
  "actorSpecification": 1,
  "fields": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "description": "URL of the filtered page",
        "nullable": true,
        "example": "https://docs.example.com/short-page"
      },
      "filterReason": {
        "type": "string",
        "description": "Why the page was rejected (extraction, language, length, quality, dedup, non_html)",
        "nullable": true,
        "example": "length"
      }
    },
    "required": [],
    "additionalProperties": true
  },
  "views": {
    "overview": {
      "title": "Rejected pages",
      "transformation": {
        "fields": ["url", "filterReason"]
      },
      "display": {
        "component": "table",
        "properties": {
          "url": { "label": "URL", "format": "link" },
          "filterReason": { "label": "Reason", "format": "text" }
        }
      }
    }
  }
}
